# Copy to .env and adjust as needed. All variables are optional -- defaults
# in app/config.py already match the notebook's trained models layout.

APP_MODELS_DIR=models
APP_METADATA_PATH=models/metadata.json
APP_HISTORY_DB_PATH=data/history.db
APP_HISTORY_DEFAULT_LIMIT=20
APP_CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# Only needed for deployment, when models/ isn't already populated locally.
# See backend/README.md "Deploying" section.
# APP_HF_REPO_ID=your-username/cow-sheep-classifier-models
# HF_TOKEN=hf_xxx   # only if that HF repo is private
